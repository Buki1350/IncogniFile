# Optional environment overrides (native Rust does not automatically read .env).
APP_ORIGIN=http://localhost:8080
# Set true to demonstrate local email verification.
REQUIRE_EMAIL_VERIFICATION=false
MAIL_DELIVERY=local
# SMTP only when MAIL_DELIVERY=smtp; never commit real credentials.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-account
# SMTP_PASSWORD=your-password
# MAIL_FROM=no-reply@example.com
